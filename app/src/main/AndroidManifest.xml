<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The list is user-editable, so we can't enumerate targets at build time
      the way a single-purpose shim could. QUERY_ALL_PACKAGES is protection
      level "normal" and is granted at install.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!--
      Page-turn haptic. Calling Vibrator directly needs this; performHapticFeedback
      would not, but its prebaked effects do not match what LightOS plays.
      Protection level is normal, so it is granted at install.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Menu"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          Marks Menu as a LightOS "tool" so it survives the toolbox filter
          when external tools are switched off. Matched against the
          declaration in a real light-sdk tool. See SdkMarkerReceiver.
        -->
        <receiver
            android:name=".SdkMarkerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.thelightphone.sdk.ACTION_SDK_MARKER" />
            </intent-filter>
            <meta-data
                android:name="com.thelightphone.sdk.SDK_VERSION"
                android:value="0.1.1" />
        </receiver>
    </application>
</manifest>
